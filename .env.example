# Copy this file to .env and fill in real values. Never commit .env.

GEMINI_API_KEY=your-gemini-api-key
ADMIN_EXPORT_PASSWORD=choose-a-long-random-password
AI_MODEL=gemini-3.6-flash
CONTACT_EMAIL=you@example.com

# Optional for local dev — leave both unset and it falls back to a local
# SQLite file at data/study.db. REQUIRED on Render (or any host with an
# ephemeral filesystem) — without these, the database resets on every
# redeploy and spin-down. Get these from your Turso database's dashboard.
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Enables flagged test/soak runs. Leave unset to disable test mode entirely
# (then no test rows can be created). Pick a long random string and set it as
# an env var on the host; open the study with ?test=<token> for a flagged
# browser session, or send it as "test_token" to /api/consent with a
# "test-"-prefixed participant_id from scripts.
TEST_MODE_TOKEN=choose-a-long-random-string
